# ======================================================================
# CONFIGURACOES DE AMBIENTE - nexRNC (Template Comercial & White-Label)
# Copie este arquivo para .env dentro da pasta backend/
# ======================================================================

# PARAMETROS DE BANCO DE DADOS
# Opcao 1: SQL Server (Empresarial / On-Premise)
DB_SERVER=localhost
DB_DATABASE=NEX_RNC
DB_USER=sa
DB_PASSWORD=SuaSenhaForteAqui
DB_PORT=1433
DB_DRIVER=ODBC Driver 17 for SQL Server
USE_SQL_SERVER=false
ALLOW_SQLITE_FALLBACK=true

# Opcao 2: SQLite Local (Desenvolvimento Rapido ou Testes Sem Servidor)
# Quando USE_SQL_SERVER=false, o sistema armazena automaticamente em backend/data/nexrnc.db

# CONFIGURACOES DA APLICACAO
APP_NAME="nexRNC - Sistema de Gestao de Nao Conformidades"
APP_BASE_URL=http://localhost:3010
API_PORT=8001
DEMO_MODE=false

# NOTIFICACOES POR E-MAIL (SMTP)
SMTP_ENABLED=false
SMTP_SERVER=smtp.exemplo.com.br
SMTP_PORT=587
SMTP_USER=notificacoes@suaempresa.com.br
SMTP_PASSWORD=SuaSenhaSmtp
SMTP_FROM="nexRNC <notificacoes@suaempresa.com.br>"
SMTP_TLS=true

# DESTINATARIOS SETORIAIS PADRAO
EMAIL_COORD_COMERCIAL=comercial@suaempresa.com.br
EMAIL_EXPEDICAO=expedicao@suaempresa.com.br
EMAIL_PRODUCAO=producao@suaempresa.com.br
EMAIL_QUALIDADE=qualidade@suaempresa.com.br
EMAIL_FINANCEIRO=financeiro@suaempresa.com.br
EMAIL_GESTAO=diretoria@suaempresa.com.br
